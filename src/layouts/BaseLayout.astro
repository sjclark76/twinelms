---
import '../styles/global.css';
import { DEFAULT_LOCALE, LOCALES, type Locale } from '../i18n/config';
import { useStrings } from '../i18n/ui';
import SiteHeader from '../components/SiteHeader.astro';
import SiteFooter from '../components/SiteFooter.astro';

interface Props {
  title: string;
  description?: string;
  noindex?: boolean;
  locale?: Locale;
}
const {
  title,
  description = 'The Nest at Twin Elms, Lake Hawea',
  noindex = false,
  locale = DEFAULT_LOCALE,
} = Astro.props;
const t = useStrings(locale);
---

<!doctype html>
<html lang={LOCALES[locale].htmlLang}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    {noindex && <meta name="robots" content="noindex" />}
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <title>{title}</title>
  </head>
  <body>
    <div class="nest">
      <a class="nest-skip" href="#main">{t.skipToContent}</a>
      <SiteHeader locale={locale} pathname={Astro.url.pathname} />
      <slot />
      <SiteFooter locale={locale} />
    </div>
  </body>
</html>
