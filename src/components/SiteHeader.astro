---
import { localePath, stripLocale, type Locale } from '../i18n/config';
import { useStrings } from '../i18n/ui';
import LanguageSwitcher from './LanguageSwitcher.astro';
import { headerMenu } from '../data/inline-scripts';

interface Props {
  locale: Locale;
  pathname: string;
  /** Don't mark any page as current (used on not-found pages). */
  noCurrent?: boolean;
}
const { locale, pathname, noCurrent = false } = Astro.props;
const t = useStrings(locale);
const current = stripLocale(pathname);
const links = [
  { href: '/', label: t.nav.home },
  { href: '/guide/', label: t.nav.guide },
  { href: '/map/', label: t.nav.map },
  { href: '/gallery/', label: t.nav.gallery },
];
---

<header class="nest-header">
  <div class="nest-header-inner">
    <a class="nest-wordmark" href={localePath(locale, '/')}>
      The Nest at Twin Elms<small>{t.wordmarkSub}</small>
    </a>
    <button class="nest-menu-btn" type="button" aria-expanded="false" aria-controls="nest-main-nav">
      <svg class="nest-menu-icon" aria-hidden="true" viewBox="0 0 24 24">
        <path class="nest-menu-open" d="M4 7h16M4 12h16M4 17h16" />
        <path class="nest-menu-close" d="M6 6l12 12M18 6L6 18" />
      </svg>
      <span>{t.nav.menu}</span>
    </button>
    <LanguageSwitcher locale={locale} pathname={pathname} />
    <nav id="nest-main-nav" aria-label={t.mainNav}>
      <ul class="nest-nav">
        {
          links.map((l) => (
            <li>
              <a href={localePath(locale, l.href)} aria-current={!noCurrent && current === l.href ? 'page' : undefined}>
                {l.label}
              </a>
            </li>
          ))
        }
      </ul>
    </nav>
  </div>
</header>

<script is:inline set:html={headerMenu} />
