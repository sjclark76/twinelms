---
// Simple 1.5px line icons (24x24), drawn in the lake colour by the surrounding styles.
interface Props {
  name: 'clock' | 'wifi' | 'smoke' | 'bin' | 'phone' | 'basket' | 'pill' | 'cash';
}
const paths: Record<Props['name'], string> = {
  clock: '<circle cx="12" cy="12" r="9"/><path d="M12 7v5l3 2"/>',
  wifi: '<path d="M3 9a14 14 0 0 1 18 0M6 12.5a9.5 9.5 0 0 1 12 0M9 16a5 5 0 0 1 6 0"/><circle cx="12" cy="19" r="1"/>',
  smoke: '<circle cx="12" cy="12" r="9"/><path d="M5.6 5.6l12.8 12.8"/>',
  bin: '<path d="M4 7h16M6 7l1 13h10l1-13M9 7V4h6v3"/>',
  phone: '<path d="M5 4h4l2 5-2.5 1.5a11 11 0 0 0 5 5L15 13l5 2v4a1 1 0 0 1-1 1A16 16 0 0 1 4 5a1 1 0 0 1 1-1z"/>',
  basket: '<path d="M3 9h18l-2 11H5L3 9zM8 9l3-5M16 9l-3-5"/>',
  pill: '<rect x="3" y="9" width="18" height="6" rx="3" transform="rotate(-45 12 12)"/><path d="M9.5 9.5l5 5"/>',
  cash: '<rect x="3" y="6" width="18" height="12" rx="2"/><circle cx="12" cy="12" r="2.5"/>',
};
const { name } = Astro.props;
---

<svg aria-hidden="true" viewBox="0 0 24 24" set:html={paths[name]} />
