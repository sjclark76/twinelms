---
import { Picture } from 'astro:assets';
import { PHOTO_FORMATS, PHOTO_QUALITY } from '../data/images';
// The round photo is optional; without one the tussock circle shows an initial.
interface Props {
  name: string;
  kind: string;
  body: string;
  initial: string;
  photo?: ImageMetadata;
  photoAlt?: string;
}
const { name, kind, body, initial, photo, photoAlt } = Astro.props;
---

<article class="nest-card nest-animal">
  {
    photo && photoAlt ? (
      <div class="nest-animal-face">
        <Picture formats={PHOTO_FORMATS} quality={PHOTO_QUALITY} src={photo} alt={photoAlt} width={128} height={128} densities={[1, 2]} />
      </div>
    ) : (
      <div class="nest-animal-face" aria-hidden="true">{initial}</div>
    )
  }
  <div>
    <h3>{name}</h3>
    <p class="nest-kind">{kind}</p>
    <p>{body}</p>
  </div>
</article>

<style>
  .nest-animal {
    max-width: none;
    padding: 20px;
  }
</style>
