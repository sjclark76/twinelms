---
import BaseLayout from '../layouts/BaseLayout.astro';
import { useStrings } from '../i18n/ui';
import { LOCALES, type Locale } from '../i18n/config';
import { nestLocation } from '../data/home';
import { TURNSTILE_SITE_KEY, turnstileLanguage } from '../data/turnstile';
import type { MapConfig } from '../scripts/map/text';

interface Props {
  locale: Locale;
}
const { locale } = Astro.props;
const t = useStrings(locale).map;
// Everything the map script needs, passed as JSON so the script itself has no text in it.
const config: MapConfig = {
  locale: LOCALES[locale].htmlLang,
  home: { ...nestLocation, label: t.legendHome, place: useStrings(locale).wordmarkSub },
  turnstile: { siteKey: TURNSTILE_SITE_KEY, language: turnstileLanguage[locale] ?? 'auto' },
  strings: {
    stat: t.stat, statEmpty: t.statEmpty, towns: t.towns, countries: t.countries, visits: t.visits,
    loadError: t.loadError, noSuggestions: t.noSuggestions, suggestionsCount: t.suggestionsCount, submit: t.submit, submitting: t.submitting, success: t.success, errors: t.errors,
  },
};
---

<BaseLayout title={t.title} description={t.description} locale={locale}>
  <main id="main">
    <section class="nest-container intro">
      <h1 class="display">{t.heading}</h1>
      <p class="lead">{t.intro}</p>
    </section>

    <section class="nest-container map-section">
      <div class="map-frame">
        <div class="nest-map map" id="visitor-map" role="region" aria-label={t.mapLabel}></div>
        <span class="nest-map-stat stat" data-stat aria-live="polite"></span>
      </div>
      <noscript><p class="notice">{t.noscript}</p></noscript>
      <p class="notice" data-load-error hidden>{t.loadError}</p>
      <div class="legend">
        <span><span class="dot dot-guest" aria-hidden="true"></span>{t.legendGuests}</span>
        <span><span class="dot dot-home" aria-hidden="true"></span>{t.legendHome}</span>
        <span><span class="dot dot-guest dot-small" aria-hidden="true"></span><span class="dot dot-guest dot-big" aria-hidden="true"></span>{t.legendVisits}</span>
      </div>
      <details class="town-list" data-town-list hidden>
        <summary>{t.listToggle}</summary>
        <ul data-towns></ul>
      </details>
    </section>

    <section class="nest-container lower">
      <form class="nest-card form" data-town-form novalidate>
        <h2 class="heading-1">{t.formHeading}</h2>
        <div class="nest-field">
          <label for="town" id="town-label">{t.townLabel}</label>
          <div class="combo">
            <input class="nest-input" id="town" name="town" type="text" required maxlength="80" autocomplete="off"
              role="combobox" aria-autocomplete="list" aria-expanded="false" aria-controls="town-options"
              aria-describedby="town-help" placeholder={t.townPlaceholder} />
            <ul class="combo-list" id="town-options" role="listbox" aria-labelledby="town-label" hidden></ul>
          </div>
          <span class="nest-help" id="town-help">{t.townHelp}</span>
          <span class="nest-help credit">
            {t.searchCredit.split('{geonames}')[0]}<a href="https://www.geonames.org/">GeoNames</a>{t.searchCredit.split('{geonames}')[1]}
          </span>
          <span class="nest-sr-only" role="status" aria-live="polite" data-combo-status></span>
        </div>
        <div class="turnstile" data-turnstile></div>
        <div><button type="submit" class="nest-btn nest-btn-warm" data-submit>{t.submit}</button></div>
        <p class="message" data-message role="status" aria-live="polite"></p>
      </form>

      <div class="how">
        <h2 class="heading-1">{t.howHeading}</h2>
        <ul>
          {t.how.map((item) => <li><b>{item.title}</b><span>{item.body}</span></li>)}
        </ul>
      </div>
    </section>
  </main>
  <script type="application/json" id="map-config" set:html={JSON.stringify(config)} />
  <script is:inline src="https://challenges.cloudflare.com/turnstile/v0/api.js?render=explicit" async defer></script>
</BaseLayout>

<style>
  .intro {
    padding-top: calc(var(--space-10) + var(--space-2));
    display: flex;
    flex-direction: column;
    gap: var(--space-4);
  }
  h1,
  h2 {
    margin: 0;
  }
  .lead {
    margin: 0;
    max-width: 640px;
    font-size: 18px;
    line-height: 28px;
  }
  .map-section {
    padding-top: var(--space-6);
  }
  .map-frame {
    position: relative;
  }
  .map {
    /* Full width always; 2:1 on wide screens, never shorter than 300px on phones. */
    width: 100%;
    aspect-ratio: 2 / 1;
    min-height: 300px;
    z-index: 0;
  }
  .stat {
    z-index: 500;
    pointer-events: none;
    max-width: calc(100% - 24px);
  }
  .stat:empty {
    display: none;
  }
  .notice {
    margin: var(--space-2) 0 0;
    color: var(--slate);
  }
  .legend {
    display: flex;
    flex-wrap: wrap;
    gap: 20px;
    padding-top: 12px;
    font-size: 14px;
    line-height: 20px;
    color: var(--slate);
  }
  .legend > span {
    display: inline-flex;
    align-items: center;
    gap: var(--space-2);
  }
  .dot {
    width: 12px;
    height: 12px;
    border-radius: 50%;
  }
  .dot-guest {
    background: var(--tussock);
    border: 2px solid var(--ink);
  }
  .dot-small {
    width: 8px;
    height: 8px;
    margin-right: -4px;
  }
  .dot-big {
    width: 16px;
    height: 16px;
  }
  .dot-home {
    background: var(--clay);
  }
  .town-list {
    margin-top: var(--space-4);
  }
  .town-list summary {
    cursor: pointer;
    font-weight: 600;
    color: var(--lake);
    min-height: 44px;
    display: flex;
    align-items: center;
  }
  .town-list ul {
    margin: var(--space-2) 0 0;
    padding: 0;
    list-style: none;
    columns: 2 220px;
    font-size: 15px;
  }
  .town-list :global(li) {
    padding: 4px 0;
    break-inside: avoid;
  }
  .town-list :global(li span) {
    color: var(--slate);
  }
  .lower {
    padding-top: var(--space-10);
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(min(320px, 100%), 1fr));
    gap: var(--space-6);
    align-items: start;
  }
  .form {
    padding: 20px;
    display: flex;
    flex-direction: column;
    gap: var(--space-4);
  }
  .form :global(.nest-input[aria-invalid='true']) {
    border-color: var(--clay);
  }
  .combo {
    position: relative;
  }
  .credit {
    font-size: 12px;
    line-height: 16px;
  }
  .credit a {
    color: var(--slate);
  }
  .combo-list {
    position: absolute;
    z-index: 600;
    top: calc(100% + 4px);
    left: 0;
    right: 0;
    margin: 0;
    padding: 4px 0;
    list-style: none;
    max-height: 320px;
    overflow-y: auto;
    background: var(--white);
    border: 1px solid var(--line);
    border-radius: var(--radius-sm);
  }
  .combo-list :global(li) {
    display: flex;
    flex-direction: column;
    justify-content: center;
    min-height: 44px;
    padding: 6px 14px;
    cursor: pointer;
  }
  .combo-list :global(li[aria-selected='true']) {
    background: var(--lake-tint);
  }
  .combo-list :global(li b) {
    font-weight: 600;
  }
  .combo-list :global(li span) {
    font-size: 14px;
    line-height: 20px;
    color: var(--slate);
  }
  .combo-list :global(li.empty) {
    cursor: default;
    color: var(--slate);
  }
  .turnstile:empty {
    display: none;
  }
  .message {
    margin: 0;
    font-weight: 600;
  }
  .message:empty {
    display: none;
  }
  .message[data-kind='error'] {
    color: var(--clay);
  }
  .message[data-kind='success'] {
    color: var(--beech);
  }
  .how {
    display: flex;
    flex-direction: column;
    gap: var(--space-2);
  }
  .how ul {
    margin: 0;
    padding: 0;
    list-style: none;
  }
  .how li {
    display: flex;
    flex-direction: column;
    gap: 2px;
    padding: 12px 0;
    border-top: 1px solid var(--line);
  }
  .how li span {
    font-size: 14px;
    line-height: 20px;
    color: var(--slate);
  }

  /* Leaflet, styled toward the Misty lake palette */
  .map :global(.leaflet-tile-pane) {
    filter: saturate(0.55) sepia(0.12) brightness(1.04);
  }
  .map :global(.leaflet-container),
  .map:global(.leaflet-container) {
    font: inherit;
    background: var(--lake-mist);
  }
  .map :global(.pin-icon) {
    background: none;
    border: 0;
  }
  .map :global(.pin-icon .nest-pin) {
    display: block;
  }
  .map :global(.pin-icon .nest-pin-count) {
    display: grid;
    place-items: center;
  }
  .map :global(.leaflet-marker-icon:focus-visible) {
    outline: 3px solid var(--lake);
    outline-offset: 4px;
    border-radius: 50%;
  }
  .map :global(.leaflet-popup-content-wrapper) {
    border-radius: var(--radius-sm);
    box-shadow: none;
    border: 1px solid var(--line);
  }
  .map :global(.leaflet-popup-content) {
    margin: 8px 12px;
    font-size: 14px;
    line-height: 20px;
    color: var(--ink);
  }
  .map :global(.leaflet-popup-content b) {
    display: block;
  }
  .map :global(.leaflet-control-attribution) {
    font-size: 12px;
    background: var(--white);
    border-radius: var(--radius-pill) 0 0 0;
    padding: 2px 10px;
  }
  .map :global(.leaflet-control-attribution a) {
    color: var(--lake);
  }
</style>

<script>
  // The page's behaviour lives in src/scripts/map/.
  import '../scripts/map/main';
</script>
