---
import BaseLayout from '../layouts/BaseLayout.astro';
import { Picture } from 'astro:assets';
import { PHOTO_FORMATS, PHOTO_QUALITY } from '../data/images';
import heroPhoto from '../assets/hero-hawea.jpg';
import houseSign from '../assets/house-sign.jpg';
import hostsPhoto from '../assets/hosts.jpg';
import dexterFace from '../assets/dexter-face.jpg';
import chickensFace from '../assets/chickens-face.jpg';
import AnimalCard from '../components/AnimalCard.astro';
import { useStrings } from '../i18n/ui';
import { address, airbnbUrl, hosts, postalAddress } from '../data/contact';
import { SITE_URL } from '../data/site';
import Icon from '../components/Icon.astro';
import { LOCALES, localePath, type Locale } from '../i18n/config';

interface Props {
  locale: Locale;
}
const { locale } = Astro.props;
const t = useStrings(locale).home;

// Tells search engines this is a place to stay. Only facts already on the page: no prices, ratings or availability.
const site = new URL(SITE_URL);
const schema = {
  '@context': 'https://schema.org',
  '@type': 'LodgingBusiness',
  name: 'The Nest at Twin Elms',
  description: t.description,
  url: new URL(localePath(locale, '/'), site).href,
  image: new URL('/og-image.jpg', site).href,
  inLanguage: LOCALES[locale].htmlLang,
  address: {
    '@type': 'PostalAddress',
    streetAddress: postalAddress.street,
    addressLocality: postalAddress.locality,
    postalCode: postalAddress.postcode,
    addressCountry: postalAddress.country,
  },
  sameAs: [airbnbUrl],
  checkinTime: '15:00',
  checkoutTime: '11:00',
};
---

<BaseLayout title={t.title} description={t.description} locale={locale} schema={schema}>
  <main id="main">
    <section class="nest-container section hero">
      <div class="hero-text">
        <p class="label eyebrow">{t.hero.eyebrow}</p>
        <h1 class="display">{t.hero.heading}</h1>
        <p class="lead">{t.hero.intro}</p>
        <div class="actions">
          <a class="nest-btn nest-btn-primary" href={localePath(locale, '/guide/')}>{t.hero.openGuide}</a>
          <a class="nest-btn nest-btn-quiet" href={airbnbUrl} target="_blank" rel="noopener">
            {t.hero.bookAirbnb}<span class="nest-sr-only"> {useStrings(locale).guide.links.newTab}</span>
          </a>
        </div>
      </div>
      <div class="hero-photo">
        <Picture formats={PHOTO_FORMATS} quality={PHOTO_QUALITY} src={heroPhoto} alt={t.hero.photoAlt} widths={[400, 800, 1200]} sizes="(min-width: 900px) 520px, 100vw" loading="eager" fetchpriority="high" />
      </div>
    </section>

    <section class="nest-container section stay" aria-label={t.stay.label}>
      <div class="nest-card stay-card">
        <Icon name="clock" />
        <div><p class="stay-title">{t.stay.checkIn}</p><p class="stay-sub">{t.stay.checkOut}</p></div>
      </div>
      <div class="nest-card stay-card">
        <Icon name="pin" />
        <div><p class="stay-title">{address[0]}</p><p class="stay-sub">{address[1]}</p></div>
      </div>
      <div class="nest-card stay-card">
        <Icon name="phone" />
        <div class="stay-body">
          <p class="stay-title">{t.stay.questions}</p>
          <ul class="hosts">
            {hosts.map((h) => (<li><span>{h.name}</span><a href={`tel:${h.tel}`}>{h.display}</a></li>))}
          </ul>
        </div>
      </div>
    </section>


    <section class="nest-container section about">
      <div class="about-photo">
        <Picture
          formats={PHOTO_FORMATS}
          quality={PHOTO_QUALITY}
          src={hostsPhoto}
          alt={t.about.photoAlt}
          widths={[400, 700, 1000]}
          sizes="(min-width: 900px) 520px, 100vw"
        />
      </div>
      <div class="about-text">
        <p class="label eyebrow">{t.about.eyebrow}</p>
        <h2 class="heading-1">{t.about.heading}</h2>
        <p>{t.about.body}</p>
      </div>
    </section>

    <section class="nest-container section animals">
      <div class="animals-head">
        <p class="label eyebrow">{t.animals.eyebrow}</p>
        <h2 class="heading-1">{t.animals.heading}</h2>
      </div>
      <Picture
        formats={PHOTO_FORMATS}
        quality={PHOTO_QUALITY}
        class="sign"
        src={houseSign}
        alt={t.animals.artAlt}
        widths={[480, 800, 1200]}
        sizes="(min-width: 800px) 720px, 100vw"
      />
      <div class="animals-grid">
        <AnimalCard {...t.animals.dexter} initial="D" photo={dexterFace} />
        <AnimalCard {...t.animals.chickens} initial="C" photo={chickensFace} />
        <AnimalCard {...t.animals.ducks} initial="D" />
      </div>
    </section>

    <section class="nest-container section">
      <div class="invite">
        <div class="invite-text">
          <h2 class="heading-1">{t.mapInvite.heading}</h2>
          <p>{t.mapInvite.body}</p>
        </div>
        <a class="nest-btn nest-btn-warm" href={localePath(locale, '/map/')}>{t.mapInvite.cta}</a>
      </div>
    </section>
  </main>
</BaseLayout>

<style>
  .section {
    padding-top: calc(var(--space-10) + var(--space-6));
  }
  .hero,
  .about {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-10);
    align-items: center;
  }
  .hero {
    padding-top: calc(var(--space-10) + var(--space-2));
  }
  .hero-text {
    flex: 1 1 380px;
    display: flex;
    flex-direction: column;
    gap: 20px;
    min-width: 0;
  }
  .hero-photo {
    flex: 1 1 420px;
    min-width: 0;
  }
  .hero-photo img {
    display: block;
    width: 100%;
    height: auto;
    aspect-ratio: 4 / 3;
    object-fit: cover;
    border-radius: var(--radius-md);
  }
  .eyebrow {
    margin: 0;
    color: var(--slate);
    text-transform: uppercase;
  }
  h1,
  h2 {
    margin: 0;
  }
  .lead {
    margin: 0;
    max-width: 520px;
    font-size: 18px;
    line-height: 28px;
  }
  .actions {
    display: flex;
    flex-wrap: wrap;
    gap: 12px;
  }
  .stay {
    padding-top: var(--space-10);
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(min(240px, 100%), 1fr));
    gap: var(--space-4);
  }
  .stay-card {
    display: flex;
    gap: 14px;
    align-items: flex-start;
    padding: 20px;
  }
  .stay-card :global(svg) {
    flex: none;
    width: 24px;
    height: 24px;
    fill: none;
    stroke: var(--lake);
    stroke-width: 1.6;
    stroke-linecap: round;
    stroke-linejoin: round;
  }
  .stay-card p {
    margin: 0;
  }
  .stay-title {
    font-weight: 600;
  }
  .stay-sub {
    font-size: 14px;
    line-height: 20px;
    color: var(--slate);
  }
  .stay-body {
    flex: 1;
    min-width: 0;
  }
  .hosts {
    margin: 0;
    padding: 0;
    list-style: none;
    font-size: 14px;
    line-height: 20px;
    color: var(--slate);
  }
  .hosts li {
    display: flex;
    justify-content: space-between;
    gap: var(--space-4);
  }
  .hosts li + li {
    margin-top: 4px;
  }
  /* Tap area 24px tall (the WCAG AA minimum) without spreading the two lines apart: the padding is
     cancelled by a negative margin, so the lines sit as before and the two targets just touch. */
  .hosts a {
    display: inline-block;
    padding: 2px 0;
    margin: -2px 0;
    color: var(--ink);
    font-weight: 600;
    text-align: right;
  }
  .about-photo {
    flex: 1 1 360px;
    min-width: 0;
  }
  .about-photo img {
    display: block;
    width: 100%;
    height: auto;
    aspect-ratio: 3 / 2;
    object-fit: cover;
    border-radius: var(--radius-md);
  }
  .about-text {
    flex: 1 1 380px;
    display: flex;
    flex-direction: column;
    gap: var(--space-4);
    min-width: 0;
  }
  .about-text p:last-child {
    margin: 0;
  }
  .animals {
    display: flex;
    flex-direction: column;
    gap: var(--space-6);
  }
  .animals-head {
    display: flex;
    flex-direction: column;
    gap: var(--space-2);
  }
  .sign {
    width: 100%;
    max-width: 720px;
    height: auto;
    aspect-ratio: 3 / 2;
    border-radius: var(--radius-md);
    align-self: center;
  }
  .animals-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(min(300px, 100%), 1fr));
    gap: var(--space-4);
  }
  .invite {
    background: var(--lake-tint);
    border-radius: var(--radius-md);
    padding: 32px;
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-6);
    align-items: center;
    justify-content: space-between;
  }
  .invite-text {
    flex: 1 1 360px;
    display: flex;
    flex-direction: column;
    gap: var(--space-2);
    min-width: 0;
  }
  .invite-text p {
    margin: 0;
  }
</style>
