---
import BaseLayout from '../layouts/BaseLayout.astro';
import tokens from '../../design-system/tokens.json';

// Component previews are plain HTML. Strip their demo <script> and <link> tags (previews load fonts from Google); real behaviour is built per page.
const raw = import.meta.glob('/design-system/components/*/preview.html', {
  query: '?raw',
  import: 'default',
  eager: true,
}) as Record<string, string>;
const components = Object.entries(raw).map(([path, html]) => ({
  name: path.split('/').at(-2) as string,
  html: html.replace(/<!--[\s\S]*?-->/, '').replace(/<script[\s\S]*?<\/script>/g, '').replace(/<link[^>]*>/g, ''),
}));
---

<BaseLayout title="Style guide | The Nest at Twin Elms" noindex>
  <main id="main" style="max-width: 1120px; margin: 0 auto; padding: var(--space-10) var(--space-4)">
    <h1 class="display" style="margin: 0 0 var(--space-4)">Style guide</h1>
    <p class="body">Design tokens and components from <code>design-system/</code>. Internal reference, not linked from the site.</p>

    <h2 class="heading-1" style="margin: var(--space-10) 0 var(--space-4)">Colour</h2>
    <ul style="list-style: none; margin: 0; padding: 0; display: grid; grid-template-columns: repeat(auto-fill, minmax(min(200px, 100%), 1fr)); gap: var(--space-4)">
      {tokens.color.tokens.map((t) => (
        <li class="nest-card" style="padding: var(--space-4)">
          <div style={`height: 56px; border-radius: var(--radius-sm); border: 1px solid var(--line); background: var(--${t.name})`}></div>
          <p class="heading-3" style="margin: var(--space-2) 0 0">{t.name}</p>
          <p class="small" style="margin: 0; color: var(--slate)">{t.value}</p>
        </li>
      ))}
    </ul>

    <h2 class="heading-1" style="margin: var(--space-10) 0 var(--space-4)">Type</h2>
    {tokens.type.groups.flatMap((g) => g.styles).map((s) => (
      <div style="margin-bottom: var(--space-4)">
        <p class="small" style="margin: 0; color: var(--slate)">{s.name}: {s.fontSize}/{s.lineHeight}, {s.fontWeight}</p>
        <p class={s.name} style="margin: 0">{s.sample}</p>
      </div>
    ))}

    <h2 class="heading-1" style="margin: var(--space-10) 0 var(--space-4)">Components</h2>
    {components.map((c) => (
      <section style="margin-bottom: var(--space-10)">
        <h3 class="heading-2" style="margin: 0 0 var(--space-2)">{c.name}</h3>
        <div style="border: 1px solid var(--line); border-radius: var(--radius-md); overflow: hidden" set:html={c.html} />
      </section>
    ))}
  </main>
</BaseLayout>
