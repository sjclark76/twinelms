---
import { Image, getImage } from 'astro:assets';
import type { ImageMetadata } from 'astro';
import BaseLayout from '../layouts/BaseLayout.astro';
import { useStrings } from '../i18n/ui';
import type { Locale } from '../i18n/config';
import { photos } from '../data/gallery';

const locale: Locale = 'en';
const t = useStrings(locale).gallery;

// Real photos are src/assets/gallery/<id>.jpg (or .png/.webp); photos without a file show a placeholder.
const files = import.meta.glob<{ default: ImageMetadata }>('/src/assets/gallery/*.{jpg,jpeg,png,webp}', {
  eager: true,
});
const fileFor = (id: string) =>
  Object.entries(files).find(([path]) => path.split('/').pop()?.replace(/\.[^.]+$/, '') === id)?.[1].default;

const tiles = await Promise.all(
  photos.map(async (p) => {
    const src = fileFor(p.id);
    const caption = t.photos[p.id] ?? p.id;
    const full = src ? (await getImage({ src, width: 1600, format: 'webp' })).src : undefined;
    return { ...p, src, full, caption };
  }),
);
const filters = Object.entries(t.filters);
---

<BaseLayout title={t.title} description={t.description} locale={locale}>
  <main id="main">
    <section class="nest-container intro">
      <h1 class="display">{t.heading}</h1>
      <p class="lead">{t.intro}</p>
      <nav aria-label={t.filterLabel} class="filters" data-filters hidden>
        <ul>
          {
            filters.map(([key, label]) => (
              <li>
                <button type="button" data-filter={key} aria-pressed={key === 'all' ? 'true' : 'false'}>{label}</button>
              </li>
            ))
          }
        </ul>
      </nav>
    </section>

    <section class="nest-container grid-section">
      <ul class="nest-gallery grid">
        {
          tiles.map((p) => (
            <li class:list={['tile', { wide: p.wide }]} data-tile data-category={p.category}
              data-caption={p.caption} data-full={p.full} data-tone={p.src ? undefined : p.tone}>
              <figure class="nest-tile" style={p.src ? undefined : `background: var(--${p.tone})`}>
                <button type="button" class="tile-btn" aria-label={t.viewLarger.replace('{caption}', p.caption)}>
                  {p.src && (
                    <Image src={p.src} alt="" widths={[360, 720, 1080]}
                      sizes={p.wide ? '(min-width: 760px) 720px, 100vw' : '(min-width: 760px) 360px, 100vw'}
                      format="webp" loading="lazy" />
                  )}
                </button>
                <figcaption>{p.caption}</figcaption>
              </figure>
            </li>
          ))
        }
      </ul>
    </section>

    <dialog class="lightbox" aria-label={t.viewer} data-lightbox>
      <div class="lb-stage" data-stage></div>
      <p class="lb-caption" data-caption-out></p>
      <div class="lb-controls">
        <button type="button" class="nest-btn nest-btn-quiet nest-btn-sm" data-prev>{t.prev}</button>
        <button type="button" class="nest-btn nest-btn-quiet nest-btn-sm" data-next>{t.next}</button>
        <button type="button" class="nest-btn nest-btn-primary nest-btn-sm" data-close>{t.close}</button>
      </div>
    </dialog>
  </main>
</BaseLayout>

<style>
  .intro {
    padding-top: calc(var(--space-10) + var(--space-2));
    display: flex;
    flex-direction: column;
    gap: var(--space-4);
  }
  h1 {
    margin: 0;
  }
  .lead {
    margin: 0;
    max-width: 640px;
    font-size: 18px;
    line-height: 28px;
  }
  .filters ul {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-2);
    margin: 0;
    padding: var(--space-2) 0 0;
    list-style: none;
  }
  .filters button {
    min-height: 44px;
    padding: 0 14px;
    border-radius: var(--radius-pill);
    border: 1px solid var(--line);
    background: var(--white);
    color: var(--ink);
    font: 600 14px/20px var(--font-sans);
    cursor: pointer;
  }
  .filters button:hover {
    background: var(--mist);
  }
  .filters button[aria-pressed='true'] {
    background: var(--lake);
    border-color: var(--lake);
    color: var(--white);
  }
  .filters button:focus-visible,
  .tile-btn:focus-visible {
    outline: 3px solid var(--lake);
    outline-offset: 2px;
  }
  .grid-section {
    padding-top: var(--space-6);
  }
  .grid {
    margin: 0;
    padding: 0;
    list-style: none;
    grid-template-columns: repeat(auto-fill, minmax(min(260px, 100%), 1fr));
    gap: var(--space-4);
  }
  .tile[hidden] {
    display: none;
  }
  .tile.wide {
    grid-column: span 2;
  }
  /* The wide tile fills the row height set by its neighbours (never wider than its cell). */
  .tile.wide .nest-tile {
    aspect-ratio: auto;
    height: 100%;
    min-height: 200px;
  }
  @media (max-width: 599px) {
    .tile.wide {
      grid-column: span 1;
    }
    .tile.wide .nest-tile {
      aspect-ratio: 4 / 3;
      height: auto;
    }
  }
  .tile-btn {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    margin: 0;
    padding: 0;
    border: 0;
    background: transparent;
    cursor: zoom-in;
  }
  .tile-btn :global(img) {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
  }
  .tile :global(figcaption) {
    pointer-events: none;
  }

  .lightbox {
    width: min(960px, 94vw);
    max-height: 94vh;
    padding: var(--space-4);
    border: 0;
    border-radius: var(--radius-md);
    background: var(--cream);
    color: var(--ink);
  }
  .lightbox[open] {
    display: flex;
    flex-direction: column;
    gap: var(--space-2);
  }
  .lightbox::backdrop {
    background: color-mix(in srgb, var(--ink) 85%, transparent);
  }
  .lb-stage {
    min-height: 0;
  }
  .lb-stage :global(img) {
    width: 100%;
    max-height: 70vh;
    object-fit: contain;
    display: block;
    border-radius: var(--radius-sm);
  }
  .lb-stage :global(.lb-placeholder) {
    aspect-ratio: 4 / 3;
    max-height: 70vh;
    width: 100%;
    border-radius: var(--radius-sm);
  }
  .lb-caption {
    margin: 0;
    font-weight: 600;
  }
  .lb-controls {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-2);
  }
  .lb-controls [data-close] {
    margin-left: auto;
  }
</style>

<script>
  const tiles = [...document.querySelectorAll<HTMLElement>('[data-tile]')];
  const filterBar = document.querySelector<HTMLElement>('[data-filters]');
  const dialog = document.querySelector<HTMLDialogElement>('[data-lightbox]')!;
  const stage = dialog.querySelector<HTMLElement>('[data-stage]')!;
  const captionOut = dialog.querySelector<HTMLElement>('[data-caption-out]')!;
  let current = 0;

  // Filters (shown only when scripting is available).
  if (filterBar) {
    filterBar.hidden = false;
    const buttons = [...filterBar.querySelectorAll<HTMLButtonElement>('[data-filter]')];
    buttons.forEach((button) =>
      button.addEventListener('click', () => {
        const key = button.dataset.filter;
        buttons.forEach((b) => b.setAttribute('aria-pressed', String(b === button)));
        tiles.forEach((tile) => {
          tile.hidden = key !== 'all' && tile.dataset.category !== key;
        });
      }),
    );
  }

  const visible = () => tiles.filter((tile) => !tile.hidden);

  function show(list: HTMLElement[], index: number) {
    current = (index + list.length) % list.length;
    const tile = list[current];
    stage.replaceChildren();
    if (tile.dataset.full) {
      const img = document.createElement('img');
      img.src = tile.dataset.full;
      img.alt = tile.dataset.caption ?? '';
      stage.append(img);
    } else {
      const box = document.createElement('div');
      box.className = 'lb-placeholder';
      box.style.background = `var(--${tile.dataset.tone})`;
      box.setAttribute('role', 'img');
      box.setAttribute('aria-label', tile.dataset.caption ?? '');
      stage.append(box);
    }
    captionOut.textContent = tile.dataset.caption ?? '';
  }

  tiles.forEach((tile) =>
    tile.querySelector('.tile-btn')?.addEventListener('click', () => {
      const list = visible();
      show(list, list.indexOf(tile));
      dialog.showModal();
    }),
  );

  const step = (delta: number) => show(visible(), current + delta);
  dialog.querySelector('[data-prev]')?.addEventListener('click', () => step(-1));
  dialog.querySelector('[data-next]')?.addEventListener('click', () => step(1));
  dialog.querySelector('[data-close]')?.addEventListener('click', () => dialog.close());
  dialog.addEventListener('click', (e) => {
    if (e.target === dialog) dialog.close();
  });
  dialog.addEventListener('keydown', (e) => {
    if (e.key === 'ArrowLeft') step(-1);
    if (e.key === 'ArrowRight') step(1);
  });

  // Swipe left or right on a phone.
  let startX = 0;
  dialog.addEventListener('touchstart', (e) => (startX = e.touches[0].clientX), { passive: true });
  dialog.addEventListener('touchend', (e) => {
    const dx = e.changedTouches[0].clientX - startX;
    if (Math.abs(dx) > 50) step(dx < 0 ? 1 : -1);
  });
</script>
