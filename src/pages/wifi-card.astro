---
// Printed Wi-Fi card for the room: A6 portrait, QR drawn at build time in ink on white.
import QRCode from 'qrcode';
import '../styles/global.css';
import { wifi, wifiQrText, printedCard as c } from '../data/wifi';

const { modules } = QRCode.create(wifiQrText, { errorCorrectionLevel: 'M' });
const size = modules.size;
let path = '';
for (let y = 0; y < size; y++) {
  for (let x = 0; x < size; x++) {
    if (modules.get(x, y)) path += `M${x} ${y}h1v1h-1z`;
  }
}
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="robots" content="noindex" />
    <title>Wi-Fi card | The Nest at Twin Elms</title>
  </head>
  <body>
    <main id="main">
      <article class="card">
        <p class="brand">The Nest at Twin Elms</p>
        <h1>{c.heading}</h1>
        <div class="qr">
          <svg viewBox={`-2 -2 ${size + 4} ${size + 4}`} shape-rendering="crispEdges" role="img" aria-label={c.qrLabel}>
            <path fill="var(--ink)" d={path}></path>
          </svg>
        </div>
        <p class="hint">{c.hint}</p>
        <dl>
          <dt>{c.network}</dt>
          <dd>{wifi.ssid}</dd>
          <dt>{c.password}</dt>
          <dd>{wifi.password}</dd>
        </dl>
      </article>
      <div class="controls">
        <button type="button" class="nest-btn nest-btn-primary" id="print">{c.print}</button>
        <p>{c.printHelp}</p>
      </div>
    </main>
    <script>
      document.getElementById('print')?.addEventListener('click', () => window.print());
    </script>
  </body>
</html>

<style>
  body {
    margin: 0;
    background: var(--mist);
  }
  main {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: var(--space-6);
    padding: var(--space-8) var(--space-4);
  }
  .card {
    box-sizing: border-box;
    width: 105mm;
    max-width: 100%;
    height: 148mm;
    padding: 9mm 8mm;
    display: flex;
    flex-direction: column;
    align-items: center;
    text-align: center;
    background: var(--lake-tint);
    color: var(--ink);
    border-radius: var(--radius-md);
    -webkit-print-color-adjust: exact;
    print-color-adjust: exact;
  }
  .brand {
    margin: 0;
    font: 600 11pt/1.2 var(--font-sans);
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--slate);
  }
  h1 {
    margin: 4mm 0 5mm;
    font: 600 26pt/1.1 var(--font-display);
  }
  .qr {
    width: 62mm;
    height: 62mm;
    background: var(--white);
    border-radius: var(--radius-sm);
  }
  .qr svg {
    display: block;
    width: 100%;
    height: 100%;
  }
  .hint {
    margin: 4mm 0 5mm;
    font: 400 11pt/1.3 var(--font-sans);
  }
  dl {
    margin: 0;
    display: grid;
    gap: 1mm;
  }
  dt {
    font: 600 9pt/1.2 var(--font-sans);
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--slate);
  }
  dd {
    margin: 0 0 2mm;
    font: 600 15pt/1.2 var(--font-sans);
  }
  .controls {
    max-width: 105mm;
    text-align: center;
  }
  .controls p {
    margin: var(--space-3) 0 0;
    color: var(--slate);
    font-size: 14px;
    line-height: 20px;
  }
  @page {
    size: A6 portrait;
    margin: 0;
  }
  @media print {
    body {
      background: none;
    }
    main {
      padding: 0;
      display: block;
    }
    .card {
      border-radius: 0;
    }
    .controls {
      display: none;
    }
  }
</style>
