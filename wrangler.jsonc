{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "twinelms",
  "main": "src/worker/index.ts",
  "workers_dev": true,
  "preview_urls": true,
  "previews": {},
  "compatibility_date": "2026-11-01",
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    // Missing pages get the nearest 404.html, so /de/... shows the German one.
    "not_found_handling": "404-page",
    // Only the API runs the Worker; every other request is served straight from the static site.
    "run_worker_first": ["/api/*"]
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "twinelms-visitors",
      "database_id": "8172578b-2b12-43a6-9d36-fbd6188d216e",
      "migrations_dir": "migrations"
    }
  ],
  // Per-location limit on submissions (no IP addresses are stored).
  "ratelimits": [
    {
      "name": "SUBMIT_LIMITER",
      "namespace_id": "1001",
      "simple": { "limit": 5, "period": 60 }
    }
  ]
  // TURNSTILE_SECRET is a secret: set it with `npx wrangler secret put TURNSTILE_SECRET` (and in .dev.vars for local dev).
}
