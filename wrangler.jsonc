{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "twinelms",
  "main": "src/worker/index.ts",
  "workers_dev": true,
  "preview_urls": true,
  // PR preview builds get their own bindings, so testing never touches the real guest map.
  "previews": {
    "d1_databases": [
      {
        "binding": "DB",
        "database_name": "twinelms-visitors-preview",
        "database_id": "56bc38c3-650f-48a5-94f5-52e1851229d2",
        "migrations_dir": "migrations"
      }
    ],
    "ratelimits": [
      {
        "name": "SUBMIT_LIMITER",
        "namespace_id": "1002",
        "simple": { "limit": 5, "period": 60 }
      },
      {
        "name": "SEARCH_LIMITER",
        "namespace_id": "1004",
        "simple": { "limit": 60, "period": 60 }
      }
    ],
    "vars": {
      // Cloudflare's published always-pass Turnstile test secret (not a real secret), so towns can be added on previews.
      "TURNSTILE_SECRET": "1x0000000000000000000000000000000AA"
    }
  },
  "compatibility_date": "2026-11-01",
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    // Missing pages get the nearest 404.html, so /de/... shows the German one.
    "not_found_handling": "404-page",
    // Only the API runs the Worker; every other request is served straight from the static site.
    "run_worker_first": ["/api/*"]
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "twinelms-visitors",
      "database_id": "8172578b-2b12-43a6-9d36-fbd6188d216e",
      "migrations_dir": "migrations"
    }
  ],
  // Per-location limit on submissions (no IP addresses are stored).
  "ratelimits": [
    {
      "name": "SUBMIT_LIMITER",
      "namespace_id": "1001",
      "simple": { "limit": 5, "period": 60 }
    },
    {
      // Town suggestions as guests type: generous, but protects Photon's fair-use limits.
      "name": "SEARCH_LIMITER",
      "namespace_id": "1003",
      "simple": { "limit": 60, "period": 60 }
    }
  ]
  // TURNSTILE_SECRET is a secret: set it with `npx wrangler secret put TURNSTILE_SECRET` (and in .dev.vars for local dev).
}
